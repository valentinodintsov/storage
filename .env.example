# Шаблон файла секретов. Скопируйте в .env и заполните:  cp .env.example .env
# Файл .env не хранится в репозитории (см. .gitignore).

# Строка подключения к БД.
#   Разработка:  sqlite:///./storage.db
#   PostgreSQL:  postgresql+psycopg://storage:<пароль>@localhost:5432/storage
STORAGE_DATABASE_URL=

# Ключ подписи JWT-токенов и HMAC простой ЭП, не менее 32 символов.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ВНИМАНИЕ: смена ключа делает недействительными все выданные токены и простые ЭП.
STORAGE_SECRET_KEY=

# Пароль администратора, создаваемого при первом запуске (не менее 8 символов)
STORAGE_ADMIN_PASSWORD=

# Пароль PostgreSQL для docker-compose (должен совпадать с паролем в STORAGE_DATABASE_URL)
POSTGRES_PASSWORD=

# --- Несекретные параметры (необязательно) ---
# STORAGE_ADMIN_USERNAME=admin
# STORAGE_SIGNATURE_PROVIDER=simple   # simple | cades
# STORAGE_CRYPTCP_PATH=/opt/cprocsp/bin/amd64/cryptcp  # проверка подписи cades
# STORAGE_CADES_CHECK_REVOCATION=true  # false — в закрытой сети без доступа к спискам отзыва
# STORAGE_COOKIE_SECURE=true          # включить при работе через HTTPS
# STORAGE_TOKEN_TTL_MINUTES=480
